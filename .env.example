# task-manager-cog — the names this cog reads. Names only: the values live
# in Doppler (task-manager-cog / dev locally, prd for local runs
# against production) and, for the Lambda worker, in SSM. Run under
# `doppler run -- …`; do not copy this to .env — nothing reads it.
#
# Uncommented names are required. Commented names are optional: the code
# has a default, or only production reads them. What each setting does in
# the flow: README.md.

# ─────────────────────────────────────────────────────────────────────
# Required: the board
# ─────────────────────────────────────────────────────────────────────

# external tooling: read by miniapppolis-common-utils' Asana client.
# Personal access token, read on every request, so a rotation in Doppler
# applies on the next job; and the workspace gid, for resolving tag names.
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE_ID=

# The board's project gid.
ASANA_INBOX_PROJECT_ID=

# ─────────────────────────────────────────────────────────────────────
# Required: upstream API (run reports)
# ─────────────────────────────────────────────────────────────────────

# external tooling: read by miniapppolis-common-utils' KaianoApiClient.
# Base URL of api-kaianolevine-com: production reads the unsuffixed name,
# every other environment the _DEV one, with no fallback between them. And
# this cog's named key; there is no fallback, so unset or wrong means its
# run reports are refused.
KAIANO_API_BASE_URL_DEV=
# KAIANO_API_BASE_URL=
TASK_MANAGER_COG_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Optional: columns
# ─────────────────────────────────────────────────────────────────────

# Named as they are on the board. New tasks land in ASANA_INBOX_SECTION_ID
# (unset: the project's first column). The sweep checks GROOM_SECTIONS
# (default Ideas,Refining,Blocked) and moves ready tasks to READY_SECTION
# (Ready), which it also checks again; an applied grooming leaves a task
# that is not ready, or has questions, in REFINING_SECTION (Refining), and
# a task failing in Ready goes back there; a compound task, and a task
# waiting only on blockers, waits in BLOCKED_SECTION (Blocked); a
# dispatched task goes to IN_PROGRESS_SECTION
# (In progress), and one with a draft pull request to REVIEW_SECTION
# (Review).
# ASANA_INBOX_SECTION_ID=
# GROOM_SECTIONS=
# READY_SECTION=
# REFINING_SECTION=
# BLOCKED_SECTION=
# IN_PROGRESS_SECTION=
# REVIEW_SECTION=

# ─────────────────────────────────────────────────────────────────────
# Optional: grooming
# ─────────────────────────────────────────────────────────────────────

# Moving ready tasks to Ready, and tasks waiting only on blockers to
# Blocked: off unless true; otherwise the sweep only reports them.
# GROOM_AUTO_READY=
# Sending tasks to task-groomer-cog, which is paid per task: off unless
# true, at most GROOM_DISPATCH_LIMIT tasks a sweep (default 5).
# GROOM_DISPATCH=
# GROOM_DISPATCH_LIMIT=
# The times of day tasks are sent for grooming, comma-separated HH:MM
# (e.g. 04:15,05:15), read in SWEEP_TIMEZONE (default UTC); a sweep is the
# one for a time when it starts within half an hour after it. Unset: every
# sweep sends.
# GROOM_TIMES=
# SWEEP_TIMEZONE=
# Holding tasks to the leaf or compound shape: off unless true.
# GROOM_TASK_SHAPES=
# Applying a split: reported only unless GROOM_SPLIT_DRY_RUN is false; a
# split with more children than GROOM_SPLIT_MAX_CHILDREN (default 25) is
# reported and not applied.
# GROOM_SPLIT_DRY_RUN=
# GROOM_SPLIT_MAX_CHILDREN=

# Where the fleet's repositories are listed, for checking a task's Where.
# Defaults to ecosystem-standards' ecosystem.yaml on main.
# ECOSYSTEM_YAML_URL=

# ─────────────────────────────────────────────────────────────────────
# Optional: agent dispatch at the end of the sweep
# ─────────────────────────────────────────────────────────────────────

# Off unless AGENT_DISPATCH=true; AGENT_DRY_RUN=true reports what would be
# dispatched and writes nothing. The model (default claude-sonnet-5-5), a
# run's budget and the month's in USD (defaults 2 and 20); a run still in
# flight after AGENT_RUN_TIMEOUT_MINUTES (default 90) is failed. The agent
# GitHub App starts the caller workflow (AGENT_WORKFLOW, default agent.yml)
# in the task's repository, in GITHUB_ORG (default mini-app-polis).
# AGENT_DISPATCH=
# AGENT_DRY_RUN=
# The times of day agents are dispatched, comma-separated HH:MM, read in
# SWEEP_TIMEZONE like GROOM_TIMES. Unset: every sweep dispatches.
# AGENT_TIMES=
# AGENT_MODEL=
# AGENT_TASK_CAP_USD=
# AGENT_MONTHLY_CAP_USD=
# AGENT_RUN_TIMEOUT_MINUTES=
# AGENT_WORKFLOW=
# AGENT_APP_CLIENT_ID=
# AGENT_APP_PRIVATE_KEY=
# GITHUB_ORG=

# ─────────────────────────────────────────────────────────────────────
# Optional: environment and observability
# ─────────────────────────────────────────────────────────────────────

# external tooling: read by miniapppolis-common-utils' effect_enabled,
# environment module, init_sentry and logger. Board writes are on in
# production only; ASANA_ENABLED=true allows them for a deliberate
# end-to-end test from another environment. ENVIRONMENT is set by Doppler
# per config (development in dev, production in prd). LOGGING_LEVEL
# defaults to INFO.
# ASANA_ENABLED=
# ENVIRONMENT=
# SENTRY_DSN_COGS=
# LOGGING_LEVEL=

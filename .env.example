# task-manager-cog — the names this cog reads. Names only: the values live
# in Doppler (mini-app-polis-ecosystem / dev locally, prd for local runs
# against production) and, for the Lambda worker, in SSM. Run under
# `doppler run -- …`; do not copy this to .env — nothing reads it.
#
# Uncommented names are required. Commented names are optional: the code
# has a default.

# ─────────────────────────────────────────────────────────────────────
# Required: the board
# ─────────────────────────────────────────────────────────────────────

# Personal access token. Read on every request, so a rotation in Doppler
# applies on the next job.
ASANA_ACCESS_TOKEN=
# Workspace gid, for resolving tag names.
ASANA_WORKSPACE_ID=
# The board's project gid.
ASANA_INBOX_PROJECT_ID=

# ─────────────────────────────────────────────────────────────────────
# Required: upstream API (run reports)
# ─────────────────────────────────────────────────────────────────────

# This cog's named key. There is no fallback, so unset or wrong means its
# run reports are refused.
KAIANO_API_BASE_URL=
TASK_MANAGER_COG_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────

# The column new tasks land in. Unset, Asana uses the project's first one.
# ASANA_INBOX_SECTION_ID=

# The hourly sweep. Columns are named as they are on the board. Unset,
# the sweep checks Ideas, Refining and Blocked, and only reports what is
# ready; set GROOM_AUTO_READY=true to move ready tasks to READY_SECTION.
# GROOM_SECTIONS=Ideas,Refining,Blocked
# READY_SECTION=Ready
# GROOM_AUTO_READY=false
# Sending tasks to task-groomer-cog, which is paid per task. Off unless
# true; at most GROOM_DISPATCH_LIMIT tasks a sweep.
# GROOM_DISPATCH=false
# GROOM_DISPATCH_LIMIT=5
# Where an applied grooming leaves a task that is not ready, or that has
# questions.
# REFINING_SECTION=Refining

# Where the fleet's repositories are listed, for checking a task's Where.
# Defaults to ecosystem-standards' ecosystem.yaml on main.
# ECOSYSTEM_YAML_URL=

# Board writes are on in production only. Set to true for a deliberate
# end-to-end test from another environment.
# ASANA_ENABLED=

# SENTRY_DSN_COGS=
# LOGGING_LEVEL=INFO

# Which environment this process is in. Doppler sets it per config
# (development in dev, production in prd).
# ENVIRONMENT=development

# Base URL of api-kaianolevine-com outside production. Production reads
# KAIANO_API_BASE_URL; every other environment reads this, with no fallback.
KAIANO_API_BASE_URL_DEV=
